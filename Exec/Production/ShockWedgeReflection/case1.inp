# ------------------------------------------------------------------
# Case 1 - Valencia, Celis, Mendiburu, Bravo, Khare (COB-2023-0803)
# Mi = 2.05, wedge angle = 63.4 deg -> Regular Reflection (RR)
# Units: CGS (cm, g, s, K) as used internally by PeleC/AMReX
# ------------------------------------------------------------------
max_step = 1000000
stop_time = 6.0e-3

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0 0
geometry.coord_sys   = 0        # 0 => cartesian
geometry.prob_lo     = 0.0   0.0
geometry.prob_hi     = 400.0 75.0
amr.n_cell           = 512   96

# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
# Interior, UserBC, Hard, FOExtrap, Symmetry, SlipWall, NoSlipWall
# x-lo: fixed post-shock inflow (region 2).  x-hi: outflow.
# y-lo/y-hi: inviscid reflecting walls (Euler -> SlipWall).
pelec.lo_bc = "Hard"     "SlipWall"
pelec.hi_bc = "FOExtrap" "SlipWall"

# WHICH PHYSICS (inviscid compressible Euler, no reactions - matches paper)
pelec.do_hydro      = 1
pelec.do_mol        = 0   # PPM (unsplit piecewise-parabolic method)
pelec.diffuse_vel   = 0
pelec.diffuse_temp  = 0
pelec.diffuse_spec  = 0
pelec.do_react      = 0

# TIME STEP CONTROL
pelec.cfl         = 0.3    # CFL = 0.3, as specified in the reference paper
pelec.init_shrink = 0.3
pelec.change_max  = 1.1
pelec.dt_cutoff   = 5.e-20

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval = 1
amr.v              = 1
pelec.v            = 1

# REFINEMENT / REGRIDDING (3 AMR levels -> finest dx = dx0/8 = 0.977 mm,
# matching the paper's mesh-independence study, Section 5.1)
amr.max_level       = 3
amr.ref_ratio       = 2 2 2 2
amr.regrid_int      = 2 2 2 2
amr.blocking_factor = 16
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2

# CHECKPOINT / PLOT FILES
amr.check_file = chk1
amr.check_int  = 2000
amr.plot_file  = plt1
amr.plot_int   = 200
amr.plot_vars  = density Temp pressure
amr.derive_plot_vars = x_velocity y_velocity magvel pressure

# EMBEDDED BOUNDARY: rigid wedge, apex at x = 300 cm, inclined at 63.4 deg
eb2.geom_type   = plane
eb2.plane_point  = 300.0     0.0
eb2.plane_normal = 0.893629 -0.448799

tagging.eb_refine_type   = "static"
tagging.max_eb_refine_lev = 3

# Density-ratio based shock tagging (scale-independent)
tagging.denratio         = 1.05
tagging.max_denratio_lev = 3

# PROBLEM PARAMETERS (Rankine-Hugoniot states from Table 1, CGS units)
# Region 1 (ambient, ahead of incident shock): P1=33.3306 kPa, T1=298.4 K, rho1=0.387 kg/m3
prob.p_r   = 333306.0
prob.rho_r = 3.87e-4
prob.u_r   = 0.0
# Region 2 (post-shock, Ms=2.05): computed via Eqs. (1)-(4) of the paper
prob.p_l   = 1578276.0
prob.rho_l = 1.06023e-3
prob.u_l   = 45086.0
prob.idir  = 1
prob.frac  = 0.125
